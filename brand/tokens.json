{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": "TapFlow",
  "owner": "ALVO Digital",
  "version": "1.0.0",
  "stage": "visual-identity-proposal",
  "officialLogo": {
    "wordmark": "TapFlow",
    "master": "Biblioteca /TapFlow/Identidade Visual/TapFlow_Logotipo_Oficial_Original.png",
    "vectorDerivative": "brand/tapflow-wordmark.svg",
    "hasIcon": false,
    "doNotRedraw": true
  },
  "colors": {
    "forest": "#024519",
    "lime": "#B6E229",
    "cream": "#FEFBF6",
    "ink": "#101A13",
    "sage": "#E6F1E7",
    "deepForest": "#003615"
  },
  "typography": {
    "display": {
      "family": "Sora",
      "weights": [
        700,
        800
      ],
      "fallback": "system-ui, sans-serif"
    },
    "body": {
      "family": "Sora",
      "weights": [
        400,
        500,
        600
      ],
      "fallback": "system-ui, sans-serif"
    },
    "logoType": "custom artwork; never recreate with font"
  },
  "radii": {
    "chip": "999px",
    "button": "16px",
    "card": "24px",
    "dialog": "28px"
  },
  "spacing": {
    "unit": "4px",
    "safeArea": "env(safe-area-inset-bottom, 0px)"
  },
  "motion": {
    "press": "160ms",
    "modal": "260ms",
    "feed": "320ms",
    "reducedMotion": "disable ornamental motion"
  },
  "uiRules": {
    "minTouchTarget": "44px",
    "mobileFirst": true,
    "foodVideoFocus": true,
    "textContrast": "Forest on Cream or Lime; Cream on Forest",
    "primaryCTA": "Lime surface with Forest label",
    "customerChoice": "Use restaurant imagery, not generated fake product photos as real offers"
  }
}
